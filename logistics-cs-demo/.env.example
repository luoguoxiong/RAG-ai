# 复制为 .env 后按需修改

# DeepSeek LLM
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL（chat_sessions / chat_messages / support_human / checkpoint* 等）
# 缺省值：postgres://localhost:5432/logistics_cs
DATABASE_URL=postgres://postgres:postgres@localhost:5432/logistics_cs

# Redis（可选，多实例部署推荐开启）：挂起槽位 / SSE 事件总线 / 限流窗口 / 客服在线状态
# 配置后进程无状态、可横向扩展、重启不丢挂起；不配置则降级为进程内存（单机演示模式）
# 本地开发：docker compose up -d redis （项目自带，映射 127.0.0.1:6390，避开常见 6379 冲突）
REDIS_URL=redis://127.0.0.1:6390/0

# 服务端口（多实例时用 PORT=3001/3002/... 启动多个进程）
PORT=3000

# ---------- 防御性兜底 ----------
# 入口限流：单 IP 每分钟 /api/chat 与 /api/chat/slots 请求上限（0 = 关闭）
RATE_LIMIT_PER_MIN=60
# 每进程同时在处理的 LLM 轮次上限（图执行 + 槽位续跑），超限快速失败 429
MAX_CONCURRENT_TURNS=16
# 每进程挂起槽位登记上限，超限拒绝新挂起（容量保护）
MAX_PENDING_SLOTS=10000
