# PostgreSQL (Source of Truth)
DATABASE_URL=postgres://rag:rag@localhost:5432/rag
# Redis (Queue + Cache)
REDIS_URL=redis://localhost:6380
# API
PORT=3000
HOST=0.0.0.0
# Qdrant (Vector Search)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# OpenSearch (Keyword Search / BM25)
OPENSEARCH_URL=http://localhost:9200
# Neo4j (Knowledge Graph)
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragrag1234
DEFAULT_MAX_HOPS=2
COMMUNITY_MIN_SIZE=2
DEFAULT_TOP_K=6
# Retriever 独立超时（毫秒，RetrievalPlan.timeout，§23.1）
RETRIEVER_TIMEOUT_MS=3000
# Query Intelligence（§13-15，Phase 5）
QUERY_INTELLIGENCE_ENABLED=true
MULTI_QUERY_COUNT=3
# Embedding / LLM Provider (OpenAI 兼容；未配置 key 时回退到确定性实现)
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Evaluation（§22）：指标回退容忍度，低于基线×(1-tolerance) 视为回归（CI gate）
EVAL_BASELINE_TOLERANCE=0.1